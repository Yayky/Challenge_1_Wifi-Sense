          <mxGeometry x="240" y="570" width="60" height="22" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="5 V" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#FF3333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld45_5v" target="esp_vin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="GND" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld45_gnd" target="esp_gndl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="radar TX → ESP32 RX" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#00CC66;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld45_tx" target="esp_g16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="radar RX ← ESP32 TX" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#3399FF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld45_rx" target="esp_g17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="w5" value="3.3 V" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#FF9900;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="esp_3v3" target="am_vcc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="motion on / off" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#00CC66;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="am_out" target="esp_g27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="GND" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#888888;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="am_gnd" target="esp_gndr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="w8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#FF3333;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld12_vcc" target="esp_vin">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="461" />
              <mxPoint x="400" y="191" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#888888;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld12_gnd" target="esp_gndl">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="501" />
              <mxPoint x="380" y="231" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#00CC66;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld12_tx" target="esp_g32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#3399FF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="ld12_rx" target="esp_g33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="usb" value="micro-USB → 5 V charger&#10;(powers the whole node · also used for flashing)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="480" y="650" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wusb" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="usb" target="esp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend&#10;red = 5 V  ·  orange = 3.3 V  ·  grey = ground (GND)&#10;green = data into the ESP32  ·  blue = data out of the ESP32&#10;dashed = later upgrade (LD2412)&#10;Wires that cross without a junction dot are NOT connected." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8" vertex="1" parent="1">
          <mxGeometry x="800" y="380" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="notes" value="Notes&#10;• TX always goes to RX (crossed) — the most common wiring mistake.&#10;• The radars are powered from 5 V but their data pins use 3.3 V logic, the same as the ESP32,&#10;   so they connect directly: no level shifter needed.&#10;• In the real build the power connections are made through the breadboard's + and − rails&#10;   rather than stacking several wires on one ESP32 pin — see the breadboard diagram.&#10;• The AM312 runs from 3.3 V; its OUT pin is simply high while it sees motion.&#10;• The two radars need separate UARTs because they run at different speeds (256000 vs 115200 baud)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8" vertex="1" parent="1">
          <mxGeometry x="800" y="510" width="440" height="200" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
